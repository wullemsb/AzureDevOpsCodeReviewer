## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code cache/options directory
.vscode/

# Rider directory
.idea/
*.sln.iml

# Files built by Visual Studio
*.obj
*.exe
*.exe.config
*.dll
*.so
*.dylib
*.class
*.jar
*.exe
*.out
*.app
*.exe_manifest

# Nuget personal access token and other sensitive credential files
# REMOVE THIS ENTRY if you want to checkin Nuget.Config for your team/organization
nuget.config

# NuGet Packages
*.nupkg
*.snupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/
# Uncomment if necessary however generally it is ignored
!**/packages/repositories.config
# NuGet v3's project.json files produces more ignorable files than V2's packages.config
*.nuget.props
*.nuget.targets

# Misc Visual Studio cache files
*.cap
*.cachefile
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ReSharper user-specific files
*.sln.DotSettings.user

# dotTrace
*.nettrace
*.netcore.profiler_seq

# Local History for Visual Studio
.localhistory/

# BeatPulse healthcheck temp database
healthchecksdb

# Backup & swap files
*.bak
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.*.local

# Application specific
appsettings.Development.json
appsettings.Production.json
