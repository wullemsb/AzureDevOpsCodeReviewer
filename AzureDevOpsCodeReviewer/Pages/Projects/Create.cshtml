@page
@model AzureDevOpsCodeReviewer.Pages.Projects.CreateModel
@{
    ViewData["Title"] = "Create Project";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="Index">Projects</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
    <h2>Create Project Configuration</h2>
    <p class="text-muted">Configure a new project for webhook-based code review.</p>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <div class="mb-4">
                <label asp-for="ProjectKey" class="form-label fw-semibold">Project Key</label>
                <input asp-for="ProjectKey" class="form-control" placeholder="e.g. my-project" maxlength="100"
                       pattern="[a-zA-Z0-9\-_]+" title="Only letters, numbers, hyphens, and underscores are allowed." />
                <span asp-validation-for="ProjectKey" class="text-danger"></span>
                <small class="text-muted">Used in the webhook URL: <code>/webhook/{key}</code></small>
            </div>

            <partial name="_ProjectForm" model="Model.Options" />

            <div class="form-section">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="AllowedEventsText" class="form-label">Allowed Events</label>
                        <input asp-for="AllowedEventsText" class="form-control"
                               placeholder="git.pullrequest.created, git.pullrequest.updated" />
                        <span asp-validation-for="AllowedEventsText" class="text-danger"></span>
                        <small class="text-muted">Comma-separated list of event types</small>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-lg me-1" viewBox="0 0 16 16">
                        <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022Z"/>
                    </svg>
                    Create Project
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
