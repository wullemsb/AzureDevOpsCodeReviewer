@page "{key}"
@model AzureDevOpsCodeReviewer.Pages.Projects.EditModel
@{
    ViewData["Title"] = $"Edit — {Model.Key}";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="Index">Projects</a></li>
            <li class="breadcrumb-item active">Edit: @Model.Key</li>
        </ol>
    </nav>
    <h2>Edit Project <span class="badge bg-dark badge-key">@Model.Key</span></h2>
    <p class="text-muted">Webhook URL: <code>/webhook/@Model.Key</code></p>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Key" />

            <partial name="_ProjectForm" model="Model.Options" />

            <div class="form-section">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="AllowedEventsText" class="form-label">Allowed Events</label>
                        <input asp-for="AllowedEventsText" class="form-control"
                               placeholder="git.pullrequest.created, git.pullrequest.updated" />
                        <span asp-validation-for="AllowedEventsText" class="text-danger"></span>
                        <small class="text-muted">Comma-separated list of event types</small>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-lg me-1" viewBox="0 0 16 16">
                        <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022Z"/>
                    </svg>
                    Save Changes
                </button>
                <button type="submit" asp-page-handler="RecreateServiceHooks" class="btn btn-warning">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-repeat me-1" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M2.854 7.146a.5.5 0 0 0-.708 0l-2 2a.5.5 0 1 0 .708.708L2.5 8.207l1.646 1.647a.5.5 0 0 0 .708-.708l-2-2zm13-1a.5.5 0 0 0 .708 0l2-2a.5.5 0 0 0-.708-.708L13.5 7.793l-1.646-1.647a.5.5 0 0 0-.708.708l2 2z"/>
                        <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 0-.892-.446A4 4 0 1 1 8 7a.5.5 0 0 0 0-1z"/>
                    </svg>
                    Recreate Service Hooks
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
