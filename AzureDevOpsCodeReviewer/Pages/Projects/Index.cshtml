@page
@model AzureDevOpsCodeReviewer.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Project Configurations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Project Configurations</h2>
        <p class="text-muted mb-0">Manage webhook project configurations for the code reviewer.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
        </svg>
        New Project
    </a>
</div>

@if (!Model.Projects.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="#adb5bd" class="bi bi-folder2-open mb-3" viewBox="0 0 16 16">
                <path d="M1 3.5A1.5 1.5 0 0 1 2.5 2h2.764c.958 0 1.76.56 2.311 1.184C7.985 3.648 8.48 4 9 4h4.5A1.5 1.5 0 0 1 15 5.5v.64c.57.265.94.876.856 1.546l-.64 5.124A2.5 2.5 0 0 1 12.733 15H3.266a2.5 2.5 0 0 1-2.481-2.19l-.64-5.124A1.5 1.5 0 0 1 1 6.14V3.5zM2 6h12v-.5a.5.5 0 0 0-.5-.5H9c-.964 0-1.71-.629-2.174-1.154C6.374 3.334 5.82 3 5.264 3H2.5a.5.5 0 0 0-.5.5V6zm-.367 1a.5.5 0 0 0-.496.562l.64 5.124A1.5 1.5 0 0 0 3.266 14h9.468a1.5 1.5 0 0 0 1.489-1.314l.64-5.124A.5.5 0 0 0 14.367 7H1.633z"/>
            </svg>
            <h5 class="text-muted">No project configurations yet</h5>
            <p class="text-muted mb-3">Create your first project to start reviewing pull requests.</p>
            <a asp-page="Create" class="btn btn-primary">Create Project</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Project Key</th>
                        <th>Organization</th>
                        <th>Repository</th>
                        <th>Target Reviewer</th>
                        <th>Model</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (key, opts) in Model.Projects)
                    {
                        <tr>
                            <td><span class="badge bg-dark badge-key">@key</span></td>
                            <td>@opts.AzureDevOps.Organization</td>
                            <td><code>@opts.AzureDevOps.RepositoryId</code></td>
                            <td>@opts.Review.TargetReviewer</td>
                            <td>@opts.Copilot.Model</td>
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-key="@key" class="btn btn-sm btn-outline-primary me-1">
                                    Edit
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-key="@key" class="d-inline"
                                      onsubmit="return confirm('Delete project &quot;@key&quot;? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
