<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Azure DevOps Code Reviewer</title>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="~/css/animations.css" rel="stylesheet" />
    <style>
        body { background: #f5f7fa; }
        .card { border: none; border-radius: .75rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .card-header { border-radius: .75rem .75rem 0 0 !important; }
        .nav-brand { font-weight: 700; letter-spacing: -.5px; }
        .table th { font-weight: 600; font-size: .85rem; text-transform: uppercase; letter-spacing: .5px; color: #6c757d; }
        .badge-key { font-family: 'Consolas', 'Courier New', monospace; font-size: .85rem; }
        .form-section { margin-bottom: 1.5rem; padding: 1.25rem; background: #f8f9fa; border-radius: .5rem; }
        .form-section h5 { font-size: 1rem; font-weight: 600; margin-bottom: 1rem; color: #495057; }
    </style>
</head>
<body>
    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="show">
        <div class="spinner"></div>
        <div class="spinner-text">Loading...</div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand nav-brand" asp-page="/Projects/Index">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-gear me-2" viewBox="0 0 16 16">
                    <path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/>
                    <path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.116l.094-.318z"/>
                </svg>
                Code Reviewer Admin
            </a>
        </div>
    </nav>

    <div class="container pb-5 page-container">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    <script>
        // Page animation management
        const loadingOverlay = document.getElementById('loadingOverlay');

        // Hide loading overlay when page fully loads
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                if (loadingOverlay.classList.contains('show')) {
                    loadingOverlay.classList.remove('show');
                    loadingOverlay.classList.add('hide');
                    setTimeout(function() {
                        loadingOverlay.style.display = 'none';
                    }, 300);
                }
            }, 300);
        });

        // Show loading overlay and fade out content on navigation
        document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link && !link.hasAttribute('data-no-animation') && !link.target && 
                link.href && !link.href.includes('#') && !link.href.includes('javascript:')) {

                // Check if it's an internal link
                if (link.href.startsWith(window.location.origin)) {
                    e.preventDefault();

                    // Fade out current content
                    const pageContainer = document.querySelector('.page-container');
                    if (pageContainer) {
                        pageContainer.style.animation = 'fadeOut 0.3s ease-in-out forwards';
                    }

                    // Show loading overlay and navigate
                    loadingOverlay.classList.remove('hide');
                    loadingOverlay.classList.add('show');
                    loadingOverlay.style.display = 'flex';

                    setTimeout(function() {
                        window.location.href = link.href;
                    }, 300);
                }
            }
        });

        // Handle form submissions with animation
        document.addEventListener('submit', function(e) {
            const form = e.target;
            if (!form.hasAttribute('data-no-animation')) {
                const pageContainer = document.querySelector('.page-container');
                if (pageContainer) {
                    pageContainer.style.animation = 'fadeOut 0.3s ease-in-out forwards';
                }

                loadingOverlay.classList.remove('hide');
                loadingOverlay.classList.add('show');
                loadingOverlay.style.display = 'flex';
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
