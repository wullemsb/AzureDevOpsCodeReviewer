{
  "AzureDevOps": {
    "Organization": "your-org",
    "Project": "your-project",
    "RepositoryId": "your-repo-id",
    "Pat": "your-pat",
    "TargetReviewer": "user@domain.com",
    "BaseUrl": "https://dev.azure.com"
  },
  "Copilot": {
    "Model": "gpt-5",
    "GitHubToken": "",
    "CliPath": ""
  },
  "Review": {
    "MaxFiles": 20,
    "MaxFileSizeBytes": 20000,
    "ReviewCooldownMinutes": 30,
    "AllowedEvents": [
      "pullrequest.created",
      "pullrequest.updated"
    ]
  },
  "Webhook": {
    "Token": "",
    "TokenHeaderName": "X-Webhook-Token"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
